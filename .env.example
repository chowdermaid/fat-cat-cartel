VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Dev-only browser bypass for opening /admin without Discord OAuth.
# Ignored by production builds because the code also checks import.meta.env.DEV.
VITE_ADMIN_AUTH_BYPASS=false

# Functions secret value, documented here as a reminder for local setup:
# DISCORD_MEMBER_ROLE_IDS=1336488015828357241,1336487958273855550,1375069801244004462
# DISCORD_EVENT_CHANNEL_ID=event_planner_channel_id
# RAID_HELPER_API_KEY=server_raid_helper_api_key
# RAID_HELPER_TEMPLATE_ID=ffxiv_template_id
# RAID_HELPER_FALLBACK_LEADER_ID=discord_user_id_for_local_dev_or_fallback
